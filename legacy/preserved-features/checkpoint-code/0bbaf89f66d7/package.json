{
  "name": "nemesis-android",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/browser.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "ui:extract": "node scripts/extract-ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capacitor/keyboard": "7.0.6",
    "@fontsource/inter": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@fontsource/outfit": "5.2.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "playwright": "1.56.1",
    "vite": "6.4.1"
  }
}
